<section class="cann" id="cann-{{ section.id }}">
  <div class="container">
    <div class="cann_inner">
      <div class="cann_header">
        <div class="cann_text">
          {% if section.settings.heading != blank %}
            <h2>{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <h3>{{ section.settings.subheading }}</h3>
          {% endif %}
        </div>
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link | default: '#' }}" class="cann_button">
            {{ section.settings.button_label }}
            <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0 5.14937H9.35122M4.6756 9.82493L9.35122 5.14937L4.6756 0.473755" stroke="currentColor" stroke-width="1.34" />
            </svg>
          </a>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="product_slider swiper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'product' %}
                  {% assign product = block.settings.product %}
                  <div class="swiper-slide" {{ block.shopify_attributes }}>
                    <a href="{% if product != blank %}{{ product.url }}{% else %}#{% endif %}" class="product_image">
                      {% if block.settings.image != blank %}
                        <img
                          src="{{ block.settings.image | image_url: width: 600 }}"
                          loading="lazy"
                          alt="{{ block.settings.image.alt | default: product.title | escape }}"
                          width="{{ block.settings.image.width }}"
                          height="{{ block.settings.image.height }}"
                        >
                      {% elsif product != blank and product.featured_image %}
                        <img
                          src="{{ product.featured_image | image_url: width: 600 }}"
                          loading="lazy"
                          alt="{{ product.featured_image.alt | default: product.title | escape }}"
                          width="{{ product.featured_image.width }}"
                          height="{{ product.featured_image.height }}"
                        >
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'product_image_placeholder' }}
                      {% endif %}
                    </a>
                    <div class="product_content">
                      <span class="product_size">
                        {% if block.settings.size_label != blank %}
                          {{ block.settings.size_label }}
                        {% elsif product != blank %}
                          {% if product.price_varies %}
                            From {{ product.price_min | money }}
                          {% else %}
                            {{ product.price | money }}
                          {% endif %}
                        {% endif %}
                      </span>
                      <h3 class="product_title">
                        {% if block.settings.title != blank %}
                          {{ block.settings.title }}
                        {% elsif product != blank %}
                          {{ product.title }}
                        {% endif %}
                      </h3>
                      <p class="product_desc">
                        {% if block.settings.description != blank %}
                          {{ block.settings.description }}
                        {% elsif product != blank %}
                          {{ product.description | strip_html | truncate: 90 }}
                        {% endif %}
                      </p>
                    </div>
                  </div>

                {% when 'custom_card' %}
                  <div class="swiper-slide" {{ block.shopify_attributes }}>
                    <a href="{{ block.settings.link | default: '#' }}" class="product_image">
                      {% if block.settings.image != blank %}
                        <img
                          src="{{ block.settings.image | image_url: width: 600 }}"
                          loading="lazy"
                          alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                          width="{{ block.settings.image.width }}"
                          height="{{ block.settings.image.height }}"
                        >
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'product_image_placeholder' }}
                      {% endif %}
                    </a>
                    <div class="product_content">
                      <span class="product_size">{{ block.settings.size_label }}</span>
                      <h3 class="product_title">{{ block.settings.title }}</h3>
                      <p class="product_desc">{{ block.settings.description }}</p>
                    </div>
                  </div>
              {% endcase %}
            {% endfor %}
          </div>

          <div class="swiper-controls">
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
            <div class="swiper-pagination"></div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function () {
    function initCannSlider() {
      var root = document.getElementById('cann-{{ section.id }}');
      if (!root) return;

      var sliderEl = root.querySelector('.product_slider');
      if (!sliderEl || sliderEl.swiper) return; // no slides, or already initialized

      function updateProgress(sw) {
        var fill = sw.pagination.el.querySelector('.swiper-pagination-progressbar-fill');
        if (!fill) return;
        var total = sw.slides.length - sw.params.slidesPerView;
        var scale = sw.activeIndex === 0 ? 0.5 : sw.activeIndex >= total ? 1 : (sw.activeIndex / total) * 0.5 + 0.5;
        fill.style.cssText = 'transform: translate3d(0,0,0) scaleX(' + scale + '); transform-origin: left center;';
      }

      new Swiper(sliderEl, {
        slidesPerView: 4,
        spaceBetween: 24,
        breakpoints: {
          0: { slidesPerView: 1, spaceBetween: 12 },
          480: { slidesPerView: 2, spaceBetween: 16 },
          768: { slidesPerView: 3, spaceBetween: 20 },
          1024: { slidesPerView: 4, spaceBetween: 24 },
        },
        pagination: { el: root.querySelector('.swiper-pagination'), type: 'progressbar' },
        navigation: {
          nextEl: root.querySelector('.swiper-button-next'),
          prevEl: root.querySelector('.swiper-button-prev'),
        },
        on: {
          init: function (sw) {
            updateProgress(sw);
          },
          slideChange: function (sw) {
            updateProgress(sw);
          },
        },
      });
    }

    function bootstrap() {
      if (typeof Swiper !== 'undefined') {
        initCannSlider();
        return;
      }
      // Swiper not loaded on this page yet — load it once (shared across all instances).
      if (!window.__swiperLoading) {
        window.__swiperLoading = true;

        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
        document.head.appendChild(link);

        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
        script.onload = function () {
          document.dispatchEvent(new CustomEvent('swiper:loaded'));
        };
        document.head.appendChild(script);
      }
      document.addEventListener('swiper:loaded', initCannSlider);
    }

    bootstrap();

    // Re-init when this section is edited/reloaded in the theme editor
    document.addEventListener('shopify:section:load', function (event) {
      if (event.target.querySelector && event.target.querySelector('#cann-{{ section.id }}')) {
        bootstrap();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Canned Cocktails Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Classic Canned Cocktails"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Perfectly mixed and ready to sip. Garnish if you're feeling fancy."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image (optional)",
          "info": "Overrides the product's featured image"
        },
        {
          "type": "text",
          "id": "size_label",
          "label": "Size / price label (optional)",
          "info": "Overrides the auto price text, e.g. '8PK 12OZ READY-TO-DRINK CANS • $34'"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override (optional)"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description override (optional)"
        }
      ]
    },
    {
      "type": "custom_card",
      "name": "Custom card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "size_label",
          "label": "Size / price label",
          "default": "12oz ready-to-drink cans • from $34"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Build a Case"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Choose your flavors and save up to 20%."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Canned Cocktails Slider",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "custom_card" }
      ]
    }
  ]
}
{% endschema %}
