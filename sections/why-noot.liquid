<style>
  .why_noot {
    width: 100%;
    height: auto;
    padding: 25px 0;
  }

  .why_noot .container {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 28px 0 48px;
    display: flex;
    align-items: center;
    gap: 20px;
    justify-content: space-between;
  }

  .why_noot .features {
    width: 58%;
    display: flex;
    align-items: center;
  }

  .left_content h3 {
    font-family: unset;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
    line-height: 14px;
    margin: 0;
  }

  .why_noot .left_content h2 {
    font-size: 46px;
    line-height: 56px;
    margin: 0;
    letter-spacing: 4px;
    font-weight: 500;
  }

  .why_noot .left_content p {
    font-size: 18px;
    line-height: 22px;
    margin: 0;
  }

  .why_noot .feature_col {
    align-items: center;
    text-align: center;
    padding: 25px 10px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .why_noot .features h3 {
    font-size: 20px;
    line-height: 28px;
    margin: 0;
    font-family: sans-serif;
  }

  .why_noot .features p {
    font-size: 15px;
    margin: 0;
    line-height: 22px;
  }

  .why_noot .left_content a {
    text-decoration: none;
    font-size: 16px;
    line-height: 19px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    font-weight: 500;
  }

  .why_noot .left_content {
    width: 40%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (max-width: 768px) {
    .why_noot .container {
      flex-direction: column;
      padding: 0 20px;
    }

    .left_content a {
      flex-direction: column;
    }

    .why_noot .left_content {
      width: 100%;
    }

    .why_noot .features {
      width: 100%;
      padding: 18px 8px;
    }
  }
  @media (max-width: 570px) {
    .why_noot .features {
      flex-direction: column;
    }
  }
</style>

{% style %}
  #why_noot-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }

  #why_noot-{{ section.id }} h2,
  #why_noot-{{ section.id }} h3,
  #why_noot-{{ section.id }} p,
  #why_noot-{{ section.id }} a {
    color: {{ section.settings.text_color }};
  }
{% endstyle %}

<section class="why_noot" id="why_noot-{{ section.id }}">
  <div class="container">
    <div class="left_content">
      {% if section.settings.sub_heading != blank %}
        <h3>{{ section.settings.sub_heading }}</h3>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.noot_btn != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}">{{ section.settings.noot_btn }} &rarr;</a>
      {% endif %}
    </div>
    <div class="features">
      <div class="feature_col feature_col_1">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url }}"
            alt="{{ section.settings.col_heading_1 | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {% endif %}
        {% if section.settings.col_heading_1 != blank %}
          <h3>{{ section.settings.col_heading_1 }}</h3>
        {% endif %}
        {% if section.settings.col_text_1 != blank %}
          <p>{{ section.settings.col_text_1 }}</p>
        {% endif %}
      </div>
      <div class="feature_col feature_col_2">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url }}"
            alt="{{ section.settings.col_heading_2 | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {% endif %}
        {% if section.settings.col_heading_2 != blank %}
          <h3>{{ section.settings.col_heading_2 }}</h3>
        {% endif %}
        {% if section.settings.col_text_2 != blank %}
          <p>{{ section.settings.col_text_2 }}</p>
        {% endif %}
      </div>
      <div class="feature_col feature_col_3">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url }}"
            alt="{{ section.settings.col_heading_3 | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {% endif %}
        {% if section.settings.col_heading_3 != blank %}
          <h3>{{ section.settings.col_heading_3 }}</h3>
        {% endif %}
        {% if section.settings.col_text_3 != blank %}
          <p>{{ section.settings.col_text_3 }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Noot",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#E74F1F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#fff"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Add Text"
    },
    {
      "type": "text",
      "id": "noot_btn",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature Image"
    },
    {
      "type": "text",
      "id": "col_heading_1",
      "label": "Column 1 Heading"
    },
    {
      "type": "textarea",
      "id": "col_text_1",
      "label": "Column 1 Text"
    },
    {
      "type": "text",
      "id": "col_heading_2",
      "label": "Column 2 Heading"
    },
    {
      "type": "textarea",
      "id": "col_text_2",
      "label": "Column 2 Text"
    },
    {
      "type": "text",
      "id": "col_heading_3",
      "label": "Column 3 Heading"
    },
    {
      "type": "textarea",
      "id": "col_text_3",
      "label": "Column 3 Text"
    }
  ],
  "presets": [
    {
      "name": "Why Noot"
    }
  ]
}
{% endschema %}
