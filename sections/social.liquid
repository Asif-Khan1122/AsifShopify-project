<style>
.social {
  width: 100%;
  height: auto;
}

.social img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.social .container {
  max-width: 100%;
  margin: 0 auto;
}

.social .social_inner {
  display: flex;
  align-items: stretch;
}

.social .right_image {
  width: 50%;
  display: flex;
}

.social .left_content {
  padding: 80px 40px;
  width: 50%;
  display: flex;
  flex-direction: column;
  gap: 46px;
}

.slide_wrapper {
  display: none;
  flex-direction: column;
  gap: 46px;
}

.slide_wrapper.active {
  display: flex;
}

.social .sub_heading {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 20px;
  font-weight: bold;
  text-transform: uppercase;
  color: #fff;
  letter-spacing: 2.6px;
  margin: 0;
}

.social .left_content h2 {
  font-family: "Playfair Display", Georgia, "Times New Roman", serif;
  font-size: clamp(35px, 6vw, 48px);
  color: white;
  line-height: clamp(44px, 4vw, 58px);
  margin: 0;
}

.social .author {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.social .author h4 {
  font-size: clamp(18px, 3.5vw, 22px);
  color: white;
  line-height: 28px;
  margin: 0;
  font-weight: bold;
}

.social .author p {
  font-size: clamp(16px, 3.5vw, 20px);
  color: white;
  line-height: 28px;
  margin: 0;
}

.buttons {
  display: flex;
  gap: 16px;
  align-items: center;
}

.social .prev_button {
  width: 37px;
  height: 37px;
  border: 1.5px solid #fff;
  border-radius: 50%;
  color: #fff;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.social .next {
  width: 37px;
  height: 37px;
  border: 1.5px solid #fff;
  border-radius: 50%;
  color: #fff;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.social .prev_button:hover,
.social .next:hover {
  background-color: rgba(255, 255, 255, 0.2);
  transform: scale(1.05);
  transition: all 0.3s ease;
}

.social .prev_button:active,
.social .next:active {
  transform: scale(0.95);
}

@media (max-width: 768px) {
  .social .social_inner {
    flex-direction: column;
  }

  .social .right_image,
 .social .left_content  {
    width: 100%;
  }

  .social .left_content {
    padding: 30px 20px;
  }
}

#left_content-{{ section.id }} {
  background-color: {{ section.settings.bg_color_1 }};
  transition: background-color 0.5s ease;
}
</style>

<section class="social">
  <div class="container">
    <div class="social_inner">
      <div class="right_image">
        {% if section.settings.social_image != blank %}
          <img
            src="{{ section.settings.social_image | image_url: width: 800 }}"
            alt="{{ section.settings.heading_1 | escape }}"
            loading="lazy"
            width="100%"
            height="auto"
          >
        {% endif %}
      </div>
      <div class="left_content" id="left_content-{{ section.id }}">
        <div class="slide_wrapper active" data-slide="1">
          {% if section.settings.sub_heading_1 != blank %}
            <h4 class="sub_heading">{{ section.settings.sub_heading_1 }}</h4>
          {% endif %}
          {% if section.settings.heading_1 != blank %}
            <h2>{{ section.settings.heading_1 }}</h2>
          {% endif %}
          <div class="author">
            {% if section.settings.author_name_1 != blank %}
              <h4>{{ section.settings.author_name_1 }}</h4>
            {% endif %}
            {% if section.settings.author_location_1 != blank %}
              <p>{{ section.settings.author_location_1 }}</p>
            {% endif %}
          </div>
        </div>
        <div class="slide_wrapper" data-slide="2">
          {% if section.settings.sub_heading_2 != blank %}
            <h4 class="sub_heading">{{ section.settings.sub_heading_2 }}</h4>
          {% endif %}
          {% if section.settings.heading_2 != blank %}
            <h2>{{ section.settings.heading_2 }}</h2>
          {% endif %}
          <div class="author">
            {% if section.settings.author_name_2 != blank %}
              <h4>{{ section.settings.author_name_2 }}</h4>
            {% endif %}
            {% if section.settings.author_location_2 != blank %}
              <p>{{ section.settings.author_location_2 }}</p>
            {% endif %}
          </div>
        </div>
        <div class="slide_wrapper" data-slide="3">
          {% if section.settings.sub_heading_3 != blank %}
            <h4 class="sub_heading">{{ section.settings.sub_heading_3 }}</h4>
          {% endif %}
          {% if section.settings.heading_3 != blank %}
            <h2>{{ section.settings.heading_3 }}</h2>
          {% endif %}
          <div class="author">
            {% if section.settings.author_name_3 != blank %}
              <h4>{{ section.settings.author_name_3 }}</h4>
            {% endif %}
            {% if section.settings.author_location_3 != blank %}
              <p>{{ section.settings.author_location_3 }}</p>
            {% endif %}
          </div>
        </div>
        <div class="buttons">
          <div class="prev_button">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12.5 15L7.5 10L12.5 5" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <div class="next">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social",
  "settings": [
    {
      "type": "image_picker",
      "id": "social_image",
      "label": "Social Image"
    },
    {
      "type": "header",
      "content": "Slide 1 Colors"
    },
    {
      "type": "color",
      "id": "bg_color_1",
      "label": "Background Color - Slide 1",
      "default": "#e74c3c"
    },
    {
      "type": "header",
      "content": "Slide 2 Colors"
    },
    {
      "type": "color",
      "id": "bg_color_2",
      "label": "Background Color - Slide 2",
      "default": "#3498db"
    },
    {
      "type": "header",
      "content": "Slide 3 Colors"
    },
    {
      "type": "color",
      "id": "bg_color_3",
      "label": "Background Color - Slide 3",
      "default": "#2ecc71"
    },
    {
      "type": "header",
      "content": "Slide 1 Content"
    },
    {
      "type": "text",
      "id": "sub_heading_1",
      "label": "Add Sub Heading 1",
      "default": "Sub Heading"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Add Heading 1",
      "default": "Main Heading"
    },
    {
      "type": "text",
      "id": "author_name_1",
      "label": "Add Author Name",
      "default": "John Doe"
    },
    {
      "type": "text",
      "id": "author_location_1",
      "label": "Add Location",
      "default": "New York, USA"
    },
    {
      "type": "header",
      "content": "Slide 2 Content"
    },
    {
      "type": "text",
      "id": "sub_heading_2",
      "label": "Add Sub Heading 2",
      "default": "Sub Heading"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Add Heading 2",
      "default": "Main Heading"
    },
    {
      "type": "text",
      "id": "author_name_2",
      "label": "Add Author Name",
      "default": "John Doe"
    },
    {
      "type": "text",
      "id": "author_location_2",
      "label": "Add Location",
      "default": "New York, USA"
    },
    {
      "type": "header",
      "content": "Slide 3 Content"
    },
    {
      "type": "text",
      "id": "sub_heading_3",
      "label": "Add Sub Heading 3",
      "default": "Sub Heading"
    },
    {
      "type": "text",
      "id": "heading_3",
      "label": "Add Heading 3",
      "default": "Main Heading"
    },
    {
      "type": "text",
      "id": "author_name_3",
      "label": "Add Author Name",
      "default": "John Doe"
    },
    {
      "type": "text",
      "id": "author_location_3",
      "label": "Add Location",
      "default": "New York, USA"
    }
  ],
  "presets": [
    {
      "name": "Social",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

<script>
  const slides = document.querySelectorAll('.slide_wrapper');
  const prevBtn = document.querySelector('.prev_button');
  const nextBtn = document.querySelector('.next');
  const leftContent = document.getElementById('left_content-{{ section.id }}');
  
  // Store background colors from Liquid settings
  const bgColors = {
    1: '{{ section.settings.bg_color_1 }}',
    2: '{{ section.settings.bg_color_2 }}',
    3: '{{ section.settings.bg_color_3 }}'
  };
  
  let current = 0;
  let startX = 0;
  
  function goToSlide(index) {
    if (!slides.length) return;
    slides.forEach((slide) => slide.classList.remove('active'));
    current = (index + slides.length) % slides.length;
    slides[current].classList.add('active');
    
    // Change background color based on active slide
    const slideNumber = slides[current].getAttribute('data-slide');
    if (leftContent && bgColors[slideNumber]) {
      leftContent.style.backgroundColor = bgColors[slideNumber];
    }
  }
  
  if (nextBtn && prevBtn) {
    nextBtn.addEventListener('click', () => goToSlide(current + 1));
    prevBtn.addEventListener('click', () => goToSlide(current - 1));
  }
  
  if (leftContent) {
    leftContent.addEventListener('mousedown', (e) => {
      startX = e.clientX;
    });
    leftContent.addEventListener('mouseup', (e) => {
      const diff = startX - e.clientX;
      if (diff > 50) goToSlide(current + 1);
      if (diff < -50) goToSlide(current - 1);
    });
    leftContent.addEventListener('touchstart', (e) => {
      if (e.touches.length > 0) {
        startX = e.touches[0].clientX;
      }
    });
    leftContent.addEventListener('touchend', (e) => {
      const diff = startX - e.changedTouches[0].clientX;
      if (diff > 50) goToSlide(current + 1);
      if (diff < -50) goToSlide(current - 1);
    });
  }
</script>