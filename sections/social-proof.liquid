<style>
    .social_proof {
      max-width: 100%;
      margin: 0 auto;
      padding: 20px 0;
      background-color: {{ section.settings.bg_color }}
    }

    .social_proof_wrapper {
      display: flex;
      gap: 15px;
      width: 100%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .social_proof_wrapper::-webkit-scrollbar {
      display: none;
    }

    .card {
      flex: 0 0 auto;
      max-width: 300px;
      scroll-snap-align: start;
    }

    .card.card3 {
      display: flex;
      max-width: 400px;
      flex-direction: column;
    }

  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  img.half_image {
    height: 50%;
    border-radius: 25px 0 0 0;
  }

  .testimonials {
    background: #f25a1f;
    color: white;
    padding: 50px 30px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 50%;
    border-radius: 0 0 25px 0;
  }

  .testimonials h2 {
    font-size: 24px;
    margin-bottom: 10px;
    color: {{ section.settings.heading_color }};
  }

  .testimonials h3 {
    color: {{ section.settings.heading_color }};
    font-size: 18px;
    font-weight: normal;
  }

  @media (max-width: 768px) {
  .testimonials{
    padding: 35px 20px;
  }

  .card {
    max-width: 250px;
  }

  .card.card3 {
    max-width: 300px;
    }

  }
</style>

<section class="social_proof">
  <div class="social_proof_wrapper">
    <div class="card card1">
      {% if section.settings.image_1 %}
        <img
          src="{{ section.settings.image_1 | image_url }}"
          alt="{{ section.settings.image_1.alt | default: 'Image 1' }}"
          loading="lazy"
          width="{{ section.settings.image_1.width }}"
          height="{{ section.settings.image_1.height }}"
        >
      {% endif %}
    </div>

    <div class="card card2">
      {% if section.settings.image_2 %}
        <img
          src="{{ section.settings.image_2 | image_url }}"
          alt="{{ section.settings.image_2.alt | default: 'Image 2' }}"
          loading="lazy"
          width="{{ section.settings.image_2.width }}"
          height="{{ section.settings.image_2.height }}"
        >
      {% endif %}
    </div>

    <div class="card card3">
      {% if section.settings.image_3 %}
        <img
          class="half_image"
          src="{{ section.settings.image_3 | image_url }}"
          alt="{{ section.settings.image_3.alt | default: 'Image 3' }}"
          loading="lazy"
          width="{{ section.settings.image_3.width }}"
          height="{{ section.settings.image_3.height }}"
        >
      {% endif %}
      <div class="testimonials" role="complementary" aria-label="Testimonial">
        {% if section.settings.quote != blank %}
          <h2>{{ section.settings.quote }}</h2>
        {% endif %}
        {% if section.settings.author != blank %}
          <h3>{{ section.settings.author }}</h3>
        {% endif %}
      </div>
    </div>

    <div class="card card4">
      {% if section.settings.image_4 %}
        <img
          src="{{ section.settings.image_4 | image_url }}"
          alt="{{ section.settings.image_4.alt | default: 'Image 4' }}"
          loading="lazy"
          width="{{ section.settings.image_4.width }}"
          height="{{ section.settings.image_4.height }}"
        >
      {% endif %}
    </div>

    <div class="card card3">
      {% if section.settings.image_3 %}
        <img
          class="half_image"
          src="{{ section.settings.image_3 | image_url }}"
          alt="{{ section.settings.image_3.alt | default: 'Image 3' }}"
          loading="lazy"
          width="{{ section.settings.image_3.width }}"
          height="{{ section.settings.image_3.height }}"
        >
      {% endif %}
      <div class="testimonials" role="complementary" aria-label="Testimonial">
        {% if section.settings.quote != blank %}
          <h2>{{ section.settings.quote }}</h2>
        {% endif %}
        {% if section.settings.author != blank %}
          <h3>{{ section.settings.author }}</h3>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fbf9f2"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Add Quote",
      "default": "Great product!"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Add Author",
      "default": "Happy Customer"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Text Color",
      "default": "#fff"
    }
  ],
  "presets": [
    {
      "name": "Features"
    }
  ]
}
{% endschema %}
