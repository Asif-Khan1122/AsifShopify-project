{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{settings.media_shadow_vertical_offset | at_least: 0}}px + 2rem);
    }
  }
{%- endstyle -%}

<div class="collection-hero{% if section.settings.show_collection_image and section.settings.custom_collection_image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      <h1 class="collection-hero__title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {%- if section.settings.custom_heading != blank -%}
          {{- section.settings.custom_heading | escape -}}
        {%- else -%}
          {{- collection.title | escape -}}
        {%- endif -%}
      </h1>

      {%- if section.settings.show_collection_description -%}
        <div class="collection-hero__description rte">
          {%- if section.settings.custom_description != blank -%}
            {{ section.settings.custom_description }}
          {%- else -%}
            {{ collection.description }}
          {%- endif -%}
        </div>
      {%- endif -%}

      <ul class="collection-banner__features">
        {% if section.settings.feature_1 != blank %}
          <li>{{ section.settings.feature_1 }}</li>
        {% endif %}

        {% if section.settings.feature_2 != blank %}
          <li>{{ section.settings.feature_2 }}</li>
        {% endif %}

        {% if section.settings.feature_3 != blank %}
          <li>{{ section.settings.feature_3 }}</li>
        {% endif %}
      </ul>
    </div>

    {% if section.settings.show_collection_image and section.settings.custom_collection_image %}
      <div class="collection-hero__image-container media gradient">
        <img
          src="{{ section.settings.custom_collection_image | image_url: width: 1500 }}"
          srcset="
            {{ section.settings.custom_collection_image | image_url: width: 165 }} 165w,
            {{ section.settings.custom_collection_image | image_url: width: 360 }} 360w,
            {{ section.settings.custom_collection_image | image_url: width: 535 }} 535w,
            {{ section.settings.custom_collection_image | image_url: width: 750 }} 750w,
            {{ section.settings.custom_collection_image | image_url: width: 1070 }} 1070w,
            {{ section.settings.custom_collection_image | image_url: width: 1500 }} 1500w
          "
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ section.settings.custom_collection_image.alt | escape }}"
          width="{{ section.settings.custom_collection_image.width }}"
          height="{{ section.settings.custom_collection_image.height }}"
          loading="lazy"
        >
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section collection_hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "text",
      "id": "custom_heading",
      "label": "Custom Heading (leave blank to use collection title)"
    },
    {
      "type": "richtext",
      "id": "custom_description",
      "label": "Custom Description (leave blank to use collection description)"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "image_picker",
      "id": "custom_collection_image",
      "label": "Custom Collection Image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "feature_1",
      "label": "Feature 1",
      "default": "Zero Alcohol"
    },
    {
      "type": "text",
      "id": "feature_2",
      "label": "Feature 2",
      "default": "Zero Sugar"
    },
    {
      "type": "text",
      "id": "feature_3",
      "label": "Feature 3",
      "default": "Wildly Delicious"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-collection-banner.name"
    }
  ]
}
{% endschema %}
