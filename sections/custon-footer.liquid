<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .footer {
    width: 100%;
    padding: 30px 0;
    background-color: {{ section.settings.bg_color }} ;
  }

  .footer .container {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .footer .footer_inner {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .footer_top {
    display: flex;
    justify-content: space-between;
    position: relative;
    z-index: 1;
  }

  .top_left {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .footer h3 {
    font-size: clamp(34px, 4vw, 48px);
    color: #fff;
    line-height: 56px;
    font-weight: 600;
    font-family: 'Playfair Display', sans-serif;
  }

  .footer .top_left p {
    font-size: clamp(16px, 2vw, 18px);
    color: #fff;
    font-family: 'Inter', sans-serif;
  }
  .footer_form {
    width: 100%;
  }

  form#contact_form {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    background: #fff;
    padding: 1px;
    border-radius: 6px;
  }

  .footer_form input[type='email'] {
    padding: 14px 22px;
    outline: none;
    border: none;
    background: rgb(249 211 199);
    border-radius: 6px;
    width: 100%;
    min-width: 0;
  }

  .footer_form button {
    padding: 9px 20px;
    border: none;
    background: transparent;
    cursor: pointer;
    flex-shrink: 0;
  }

  .footer_socials {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .footer_nav {
    display: flex;
    gap: 60px;
  }

  .footer_nav-col {
    display: flex;
    flex-direction: column;
    gap: 17px;
  }

   .footer_nav-col h4 {
    font-size: clamp(22px, 2vw, 30px);
    color: #fff;
    font-weight: 600;
    line-height: clamp(30px, 4vw, 38px);
    font-family: 'Playfair Display';
  }
  .footer ul.shop_ul,
  .footer ul.connect_ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .footer_nav-col ul li a {
    color: #fff;
    font-size: clamp(15px, 2vw, 17px);
    text-decoration: none;
    line-height: clamp(19px, 3vw, 23px);
    font-family: 'Inter', sans-serif;
  }

  .footer .footer_bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin: auto;
    padding-top: 25px;
    border-top: 2px solid white;
  }

  .footer p.copyright {
    font-size: clamp(14px, 2vw, 16px);
    color: #fff;
  }

  .footer ul.last_ul {
    list-style: none;
    display: flex;
    gap: 8px;
  }
  .footer .last_ul li a {
    text-decoration: none;
    color: #fff;
    font-size: clamp(12px, 2vw, 16px);
    line-height: clamp(18px, 3vw, 20px);
    font-family: 'Inter', sans-serif;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 30px 0;
    }

    .footer .footer_inner {
      flex-direction: column;
    }

    .footer_top {
      flex-direction: column;
      gap: 20px;
    }

    .footer_nav {
      flex-direction: column;
      gap: 30px;
    }

    .footer .footer_bar {
      flex-direction: column-reverse;
      gap: 14px;
    }

    .footer .last_ul {
      justify-content: space-around;
      width: 100%;
      gap: 5px;
    }
  }
  @media (max-width: 480px) {
    .footer_socials a svg {
      width: 38px;
      height: 38px;
    }

    .footer .footer_bar {
      text-align: center;
    }

    .footer ul.last_ul {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>

<footer class="footer">
  <div class="container">
    <div class="footer_inner">
      <div class="footer_top">
        <div class="top_left">
          {% if section.settings.footer_heading != blank %}
            <h3>{{ section.settings.footer_heading }}</h3>
          {% endif %}
          {% if section.settings.footer_description != blank %}
            <p>{{ section.settings.footer_description }}</p>
          {% endif %}
          <div class="footer_form">
            {% form 'customer' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.email_placeholder | default: 'Email Address' }}"
                required
              >
              <button type="submit">Subscribe</button>
            {% endform %}
          </div>
          <div class="footer_socials">
            {% if section.settings.social_instagram_link != blank %}
              <a href="{{ section.settings.social_instagram_link }}" target="_blank">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="24" cy="24" r="24" fill="white" fill-opacity="0.1"></circle>
                  <path d="M28.1641 15.668H19.8307C17.5295 15.668 15.6641 17.5334 15.6641 19.8346V28.168C15.6641 30.4692 17.5295 32.3346 19.8307 32.3346H28.1641C30.4652 32.3346 32.3307 30.4692 32.3307 28.168V19.8346C32.3307 17.5334 30.4652 15.668 28.1641 15.668Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M27.3337 23.4733C27.4366 24.1668 27.3181 24.8751 26.9952 25.4975C26.6723 26.1198 26.1614 26.6245 25.5351 26.9397C24.9088 27.2549 24.1991 27.3646 23.5069 27.2532C22.8147 27.1419 22.1752 26.815 21.6794 26.3193C21.1837 25.8235 20.8569 25.184 20.7455 24.4918C20.6341 23.7996 20.7438 23.0899 21.059 22.4636C21.3742 21.8373 21.8789 21.3264 22.5012 21.0035C23.1236 20.6806 23.8319 20.5621 24.5254 20.665C25.2328 20.7699 25.8878 21.0995 26.3935 21.6052C26.8992 22.1109 27.2288 22.7659 27.3337 23.4733Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M28.5859 19.418H28.5943" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
            {% endif %}

            {%- if section.settings.social_facebook_link != blank -%}
              <a href="{{ section.settings.social_facebook_link }}" target="_blank">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="24" cy="24" r="24" fill="white" fill-opacity="0.1"></circle>
                  <path d="M29.0026 15.668H26.5026C25.3975 15.668 24.3377 16.107 23.5563 16.8884C22.7749 17.6698 22.3359 18.7296 22.3359 19.8346V22.3346H19.8359V25.668H22.3359V32.3346H25.6693V25.668H28.1693L29.0026 22.3346H25.6693V19.8346C25.6693 19.6136 25.7571 19.4017 25.9133 19.2454C26.0696 19.0891 26.2816 19.0013 26.5026 19.0013H29.0026V15.668Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
            {% endif %}

            {%- if section.settings.social_twitter_link != blank -%}
              <a href="{{ section.settings.social_twitter_link }}" target="_blank">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="24" cy="24" r="24" fill="white" fill-opacity="0.1"></circle>
                  <path d="M15 16L22.5 25.5L15 33H17L23.5 27L29 33H34L26 23L33.5 16H31.5L25 22.5L20 16H15Z" fill="white"></path>
                </svg>
              </a>
            {% endif %}

            {%- if section.settings.social_youtube_link != blank -%}
              <a href="{{ section.settings.social_youtube_link }}" target="_blank">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="24" cy="24" r="24" fill="white" fill-opacity="0.1"></circle>
                  <path d="M33.5 19.5C33.2 18.3 32.2 17.4 31 17.1C29 16.5 24 16.5 24 16.5C24 16.5 19 16.5 17 17.1C15.8 17.4 14.8 18.3 14.5 19.5C14 21.5 14 24 14 24C14 24 14 26.5 14.5 28.5C14.8 29.7 15.8 30.6 17 30.9C19 31.5 24 31.5 24 31.5C24 31.5 29 31.5 31 30.9C32.2 30.6 33.2 29.7 33.5 28.5C34 26.5 34 24 34 24C34 24 34 21.5 33.5 19.5Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M21.5 27.5L27.5 24L21.5 20.5V27.5Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
            {% endif %}
          </div>
        </div>
        <div class="footer_nav">
          <div class="footer_nav-col">
            {% if section.settings.menu_heading_1 != blank %}
              <h4>{{ section.settings.menu_heading_1 }}</h4>
            {% endif %}
            <ul class="shop_ul">
              {% for link in linklists[section.settings.shop_menu].links %}
                <li>
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
          <div class="footer_nav-col">
            {% if section.settings.menu_heading_2 != blank %}
              <h4>{{ section.settings.menu_heading_2 }}</h4>
            {% endif %}
            <ul class="connect_ul">
              {% for link in linklists[section.settings.connect_menu].links %}
                <li>
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
      <div class="footer_bar">
        <p class="copyright">
          &copy; {{ 'now' | date: '%Y' }}
          {{ section.settings.store_name }}
        </p>
        <ul class="last_ul">
          {% for link in linklists[section.settings.footer_menu].links %}
            <li>
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "text",
      "id": "footer_heading",
      "label": "Footer Heading",
      "default": "Stay Buzzed"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#e74f1f"
    },
    {
      "type": "text",
      "id": "footer_description",
      "label": "Footer Description",
      "default": "Get recipes, first dibs on new flavors and more."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder Text",
      "default": "Email Address"
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store Name",
      "default": ". All rights reserved."
    },
    {
      "type": "header",
      "content": "Social Media Links"
    },
    {
      "type": "url",
      "id": "social_instagram_link",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_facebook_link",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_twitter_link",
      "label": "Twitter URL"
    },
    {
      "type": "url",
      "id": "social_youtube_link",
      "label": "YouTube URL"
    },
    {
      "type": "header",
      "content": "Navigation Menus"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop Menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "connect_menu",
      "label": "Connect Menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Footer Legal Menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "menu_heading_1",
      "label": "Menu Heading 1",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "menu_heading_2",
      "label": "Menu Heading 2",
      "default": "Connect"
    }
  ],
  "presets": [
    {
      "name": "Custom Footer"
    }
  ]
}
{% endschema %}
