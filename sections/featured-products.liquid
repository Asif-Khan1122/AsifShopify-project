<style>
    .feature .product_image img {
      width: 100%;
      height: auto;
      object-fit: cover;
      display: block;
    }

    .feature {
      width: 100%;
      height: auto;
      font-family: Arial, Helvetica, sans-serif;
      padding: 20px 0;
      background-color: {{section.settings.bg_color}};
    }

    .feature .container {
      width: 100%;
      margin: auto;
      height: 100%;
      padding: 0 20px;
      max-width: 1220px;
    }

    .feature .feature_inner {
      display: flex;
      flex-direction: column;
      gap: 40px;
    }

    .feature .feature_header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .feature .feature_text {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .feature .feature_text h2 {
      font: 700 50px / 58px sans-serif;
      color: #e74f1f;
      margin: 0;
    }
    .feature .feature_text h3 {
      font: 600 22px / 30px sans-serif;
      color: #e74f1f;
      margin: 0;
    }

    .feature a.feature_button {
      padding: 14px 24px;
      font-size: clamp(14px, 2vw, 18px);
      border: 1.5px solid #e74f1f;
      background: #e74f1f;
      text-decoration: none;
      color: #fff;
      font-weight: 500;
      border-radius: 18px 0px;
      cursor: pointer;
      gap: 12px;
      display: flex;
      align-items: center;
      transition: all 0.4s ease;
    }

    .feature a.feature_button:hover {
    border: 1.5px solid #e74f1f;
    color: #e74f1f;
    background: #fff;
    }

    .feature .product_slider {
      width: 100%;
      overflow: hidden;
    }

    .swiper-slide {
      width: 100%;
      max-width: 320px;
      margin: 0 8px;
    }

    .feature .product_image {
      width: 100%;
      height: auto;
      display: flex;
    }

    .feature .product_content {
      background-color: #e74f1f;
      padding: 10px 14px;
      text-align: center;
      align-items: center;
      gap: 10px;
      display: flex;
      flex-direction: column;
      border-radius: 0 0 62px 0;
    }

    .feature span.product_size {
    font-size: 12px;
    line-height: 20px;
    color: #fff;
    margin: 0;
    }

    h3.product_title {
      font-size: 25px;
        margin: 0;
      color: #fff;
      font-weight: 600;
      line-height: 33px;
      font-family: "Playfair Display", sans-serif;
    }

    p.product_desc {
      font-size: 16px;
        margin: 0;
      color: #fff;
      line-height: 24px;
      font-weight: 500;
      width: 100%;
      max-width: 230px;
    }


    .swiper-wrapper {
    cursor: grab;
    }

    .feature .swiper-controls {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    }

    .feature .swiper-button-prev,
    .feature .swiper-button-next {
      position: static;
      width: 36px;
      height: 36px;
      border: 1.5px solid #e74f1f;
      border-radius: 50%;
      color: #e74f1f;
      flex-shrink: 0;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

  .feature .swiper-button-prev.slick-arrow,
  .feature .swiper-button-next.slick-arrow {
    display: flex !important;
    align-items: center;
    justify-content: center;
  }



  .feature .swiper-pagination {
    position: static;
    flex: 1;
    height: 3px;
    background: #e8c9bf;
    border-radius: 999px;
    overflow: hidden;
  }

  .feature .swiper-pagination-progressbar-fill {
    width: 100%;
    height: 100%;
    background: #e74f1f;
    border-radius: 999px;
    transition: transform 0.4s ease;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .feature .swiper-button-prev.swiper-button-disabled,
  .feature .swiper-button-prev.slick-disabled,
  .feature .swiper-button-next.slick-disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

<section class="feature">
  <div class="container">
    <div class="feature_inner">
      <div class="feature_header">
        <div class="feature_text">
          {% if section.settings.feature_heading != blank %}
            <h2>{{ section.settings.feature_heading }}</h2>
          {% endif %}

          {% if section.settings.sub_heading != blank %}
            <h3>{{ section.settings.sub_heading }}</h3>
          {% endif %}
        </div>

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="feature_button">
            {{ section.settings.button_label }}

            <svg
              width="11"
              height="11"
              viewBox="0 0 11 11"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M0 5.14937H9.35122M4.6756 9.82493L9.35122 5.14937L4.6756 0.473755"
                stroke="currentColor"
                stroke-width="1.34"
              ></path>
            </svg>
          </a>
        {% endif %}
      </div>

      <div class="product_slider" data-section-id="{{ section.id }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="product_image">
                {% if block.settings.product_image != blank %}
                  {{
                    block.settings.product_image
                    | image_url: width: 600
                    | image_tag: loading: 'lazy', widths: '300,400,600', alt: block.settings.product_title
                  }}
                {% endif %}
              </div>

              <div class="product_content">
                {% if block.settings.product_size != blank %}
                  <span class="product_size">{{ block.settings.product_size }}</span>
                {% endif %}

                {% if block.settings.product_title != blank %}
                  <h3 class="product_title">{{ block.settings.product_title }}</h3>
                {% endif %}

                {% if block.settings.product_desc != blank %}
                  <p class="product_desc">{{ block.settings.product_desc }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="swiper-controls">
          <div class="swiper-button-prev">
            <svg width="9" height="9" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M11 5.5H1.6M5.3 1L1 5.5L5.3 10" stroke="currentColor" stroke-width="1.34" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="swiper-button-next">
            <svg width="9" height="9" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0 5.5H9.4M5.7 1L9.4 5.5L5.7 10" stroke="currentColor" stroke-width="1.34" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="swiper-pagination">
            <div class="swiper-pagination-progressbar-fill"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "rgb(251 249 242)"
    },
    {
      "type": "text",
      "id": "feature_heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "product_size",
          "label": "Product Size"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title"
        },
        {
          "type": "textarea",
          "id": "product_desc",
          "label": "Product Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Products"
    }
  ]
}
{% endschema %}

<script src="{{ 'jquery-3.6.0.min.js' | asset_url }}" defer="defer"></script>
{{ 'slick.css' | asset_url | stylesheet_tag }}
<script src="{{ 'slick.min.js' | asset_url }}" defer="defer"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.feature .product_slider').forEach(function (sliderEl) {
      var $wrapper = jQuery(sliderEl).find('.swiper-wrapper');
      var $prev = jQuery(sliderEl).find('.swiper-button-prev');
      var $next = jQuery(sliderEl).find('.swiper-button-next');
      var $fill = jQuery(sliderEl).find('.swiper-pagination-progressbar-fill');

      function updateProgress(slick, currentSlide) {
        if (!$fill.length) return;
        var totalSteps = slick.slideCount - slick.options.slidesToShow;
        var scale;

        if (totalSteps <= 0) {
          scale = 1; // saari slides ek hi screen pe fit ho rahi hain
        } else {
          var current = currentSlide <= 0 ? 0 : currentSlide >= totalSteps ? totalSteps : currentSlide;
          scale = (current + 1) / (totalSteps + 1); // page-based fill: 50% se start, 100% pe end
        }

        $fill.css({
          transform: 'scaleX(' + scale + ')',
          'transform-origin': 'left center',
        });
      }

      // ✅ Pehle event bind karo
      $wrapper.on('init afterChange', function (event, slick, currentSlide) {
        updateProgress(slick, currentSlide !== undefined ? currentSlide : slick.currentSlide);
      });

      // ✅ Phir slick init karo
      $wrapper.slick({
        slidesToShow: 4,
        slidesToScroll: 1,
        infinite: false,
        arrows: true,
        dots: false,
        prevArrow: $prev,
        nextArrow: $next,
        responsive: [
          { breakpoint: 1024, settings: { slidesToShow: 3 } },
          { breakpoint: 768, settings: { slidesToShow: 2 } },
          { breakpoint: 480, settings: { slidesToShow: 1 } },
        ],
      });
    });
  });
</script>
